NODE_ENV=development
APP_ENV=staging
PORT=3000
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/m3allem
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=m3allem-api
JWT_AUDIENCE=m3allem-android
OTP_HMAC_SECRET=replace-with-a-different-32-character-secret
OTP_FIXED_CODE=111111
# mock simulates SMS/email/Firebase without credentials; production requires live.
DELIVERY_MODE=mock
OTP_RATE_LIMIT_MAX=100
REFRESH_TOKEN_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PROFILE_BUCKET=
S3_IDENTITY_BUCKET=
S3_PUBLIC_BASE_URL=
OTP_EMAIL_FROM=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
PUSH_DELIVERY_ENABLED=false
SHUTDOWN_TIMEOUT_MS=60000
RATE_LIMIT_REDIS_URL=
