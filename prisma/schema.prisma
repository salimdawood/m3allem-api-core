generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                   BigInt                   @id @default(autoincrement())
  phoneNumber                                          String                   @unique @map("phone_number") @db.VarChar(16)
  fullName                                             String                   @map("full_name") @db.VarChar(120)
  searchText                                           Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, (full_name)::text)")) @map("search_text")
  profileImageUploadId                                 BigInt?                  @map("profile_image_upload_id")
  nationality                                          String?                  @db.Char(2)
  recoveryEmail                                        String?                  @unique @map("recovery_email") @db.Citext
  latitude                                             Float?
  longitude                                            Float?
  address                                              String?                  @db.VarChar(255)
  isAdmin                                              Boolean                  @default(false) @map("is_admin")
  accountStatus                                        AccountStatus            @default(ACTIVE) @map("account_status")
  suspendedAt                                          DateTime?                @map("suspended_at") @db.Timestamptz(6)
  suspensionReason                                     String?                  @map("suspension_reason") @db.VarChar(500)
  createdAt                                            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                            DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                                            DateTime?                @map("deleted_at") @db.Timestamptz(6)
  authSessions                                         AuthSession[]
  contactHistory                                       ContactHistory[]
  conversationsConversationsCustomerIdTousers          Conversation[]           @relation("conversations_customer_idTousers")
  conversationsConversationsWorkerUserIdTousers        Conversation[]           @relation("conversations_worker_user_idTousers")
  devices                                              Device[]
  favorites                                            Favorite[]
  fileUploadsFileUploadsOwnerUserIdTousers             FileUpload[]             @relation("file_uploads_owner_user_idTousers")
  identityDocuments                                    IdentityDocument[]
  messages                                             Message[]
  notifications                                        Notification[]
  otpFlows                                             OtpFlow[]
  reviews                                              Review[]
  scheduledReminders                                   ScheduledReminder[]
  serviceRequestEvents                                 ServiceRequestEvent[]
  serviceRequestsServiceRequestsCustomerIdTousers      ServiceRequest[]         @relation("service_requests_customer_idTousers")
  serviceRequestsServiceRequestsStatusChangedByTousers ServiceRequest[]         @relation("service_requests_status_changed_byTousers")
  serviceRequestsServiceRequestsWorkerUserIdTousers    ServiceRequest[]         @relation("service_requests_worker_user_idTousers")
  userSettings                                         UserSettings?
  fileUploadsUsersIdProfileImageUploadIdTofileUploads  FileUpload?              @relation("users_id_profile_image_upload_idTofile_uploads", fields: [id, profileImageUploadId], references: [ownerUserId, id], onDelete: NoAction, onUpdate: NoAction, map: "user_profile_image_owner_fk")
  workerProfiles                                       WorkerProfile?

  @@index([accountStatus, id], map: "users_account_status_idx")
  @@index([fullName(ops: raw("ginTrgmOps"))], map: "users_name_trgm", type: Gin)
  @@index([searchText], map: "users_search_idx", type: Gin)
  @@map("users")
}

model RefreshToken {
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  id                 BigInt         @id @default(autoincrement())
  sessionId          BigInt         @map("session_id")
  tokenHash          Bytes          @unique @map("token_hash")
  generation         BigInt
  parentTokenId      BigInt?        @unique @map("parent_token_id")
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt             DateTime?      @map("used_at") @db.Timestamptz(6)
  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  authSessions       AuthSession    @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refreshTokens      RefreshToken?  @relation("refresh_tokensTorefresh_tokens", fields: [sessionId, parentTokenId], references: [sessionId, id], onDelete: NoAction, onUpdate: NoAction)
  otherRefreshTokens RefreshToken[] @relation("refresh_tokensTorefresh_tokens")

  @@unique([sessionId, generation])
  @@unique([sessionId, id])
  @@index([expiresAt], map: "refresh_tokens_expiry_idx")
  @@map("refresh_tokens")
}

model Device {
  deletedAt              DateTime?              @map("deleted_at") @db.Timestamptz(6)
  id                     BigInt                 @id @default(autoincrement())
  fcmToken               String                 @map("fcm_token")
  userId                 BigInt                 @map("user_id")
  platform               String                 @default("android") @db.VarChar(16)
  locale                 String?                @db.VarChar(8)
  appVersion             String?                @map("app_version") @db.VarChar(32)
  lastSeenAt             DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  users                  User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notificationDeliveries NotificationDelivery[]

  @@index([userId], map: "devices_user_idx")
  @@map("devices")
}

